\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Singular value spectra of the optics information matrix $\mathcal  {I}_{\theta \theta }$ (direct BA), its Schur complement $\mathcal  {I}_{\theta |\eta }$ after marginalising poses, and the rayfield BA (pose-free). The trailing singular values of $\mathcal  {I}_{\theta \theta }$ collapse in the Schur complement, indicating that the last $\sim $8 optical parameters are nearly unobservable when poses are jointly estimated. The rayfield BA eliminates this coupling by design.}}{13}{figure.caption.9}\protected@file@percent }
\newlabel{fig:schur}{{8}{13}{Singular value spectra of the optics information matrix $\mathcal {I}_{\theta \theta }$ (direct BA), its Schur complement $\mathcal {I}_{\theta |\eta }$ after marginalising poses, and the rayfield BA (pose-free). The trailing singular values of $\mathcal {I}_{\theta \theta }$ collapse in the Schur complement, indicating that the last $\sim $8 optical parameters are nearly unobservable when poses are jointly estimated. The rayfield BA eliminates this coupling by design}{figure.caption.9}{}}
