\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Comparison of $d_y(u,v)$ profiles across the sensor. The Zernike rayfield (measured) shows a nearly constant $d_y$ (range $0.079$), while the perspective CMO model predicts a $3\times $ larger linear gradient (range $0.232$). The telecentric model reproduces the measured profile almost exactly.}}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:dy}{{5}{9}{Comparison of $d_y(u,v)$ profiles across the sensor. The Zernike rayfield (measured) shows a nearly constant $d_y$ (range $0.079$), while the perspective CMO model predicts a $3\times $ larger linear gradient (range $0.232$). The telecentric model reproduces the measured profile almost exactly}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.5.3}Residual Analysis}{9}{subsubsection.3.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Residual evolution across model stages. Direction error $\Delta d$ (degrees) between the Zernike rayfield (reference) and each candidate model, evaluated on a $31\times 31$ pixel grid. \textbf  {Left:} Perspective CMO --- large structured error (RMS \SI {23.6}{\degree }, max \SI {27.7}{\degree }), dominated by a strong $d_y$ gradient. \textbf  {Centre:} Telecentric CMO --- RMS drops to \SI {0.27}{\degree } (two orders of magnitude), but the residual is still $Z_0^0$-dominated (global piston), revealing the missing SE(3) arm alignment. \textbf  {Right:} CMO + SE(3) --- RMS drops to \SI {0.003}{\degree }, near the noise floor. The residual heatmap at each stage directly tells the user \emph  {what} is wrong and \emph  {where} to look next.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:residuals}{{6}{10}{Residual evolution across model stages. Direction error $\Delta d$ (degrees) between the Zernike rayfield (reference) and each candidate model, evaluated on a $31\times 31$ pixel grid. \textbf {Left:} Perspective CMO --- large structured error (RMS \SI {23.6}{\degree }, max \SI {27.7}{\degree }), dominated by a strong $d_y$ gradient. \textbf {Centre:} Telecentric CMO --- RMS drops to \SI {0.27}{\degree } (two orders of magnitude), but the residual is still $Z_0^0$-dominated (global piston), revealing the missing SE(3) arm alignment. \textbf {Right:} CMO + SE(3) --- RMS drops to \SI {0.003}{\degree }, near the noise floor. The residual heatmap at each stage directly tells the user \emph {what} is wrong and \emph {where} to look next}{figure.caption.7}{}}
